#!/usr/bin/env bash
# site-ensure <name>  (root, via sudo from sites-dispatch)
# Certificate + nginx server of <name>.<SITES_DOMAIN>. Idempotent.
set -euo pipefail
source /opt/sites-platform/lib/common.sh

[[ $# -eq 1 ]] || die "uso: site-ensure <nombre>"
require_name "$1"
take_lock

host="$1.$SITES_DOMAIN"
issue_cert "$host"
apply_conf "$NGINX_DIR/site-$1.conf" "$(https_server "$host" 1m)"
printf 'ok %s\n' "$host"
