# Development defaults work without a .env (sites at http://<name>.localhost:3000).
# Copy to backend/.env and adjust for production.

NODE_ENV=production
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=sites_platform

# Published files (back this folder up together with MongoDB)
DATA_DIR=/var/lib/sites-platform

# Sites are served at https://<name>.site.whatever.tech
SITES_DOMAIN=site.whatever.tech
SITES_PROTOCOL=https
SITES_PUBLIC_PORT=

# 32+ random chars; keeps visitors of password-protected sites unlocked across restarts
SITE_COOKIE_SECRET=

# nginx in front = 1
TRUST_PROXY_HOPS=1

MAX_UPLOAD_MB=50
MAX_SITE_MB=200
MAX_SITE_FILES=2000
