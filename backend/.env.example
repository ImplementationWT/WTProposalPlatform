# Development defaults work without a .env (sites at http://<name>.localhost:3000).
# In production: /etc/sites-platform/app.env (deploy/vps/install.sh) + secrets.env (GitHub Actions secrets).

NODE_ENV=production
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=sites_platform

# Published files (back this folder up together with MongoDB)
DATA_DIR=/var/lib/sites-platform

# Sites are served at https://<name>.sites.whatever.tech (panel at panel.sites.whatever.tech)
SITES_DOMAIN=sites.whatever.tech
SITES_PROTOCOL=https
SITES_PUBLIC_PORT=

# 32+ random chars; keeps visitors of password-protected sites unlocked across restarts
SITE_COOKIE_SECRET=

# Panel login. Hash: npm run hash-password -w backend -- <password>  (without it in development: admin / admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# 32+ random chars; keeps the panel session across restarts
SESSION_SECRET=

# nginx in front = 1
TRUST_PROXY_HOPS=1

MAX_UPLOAD_MB=50
MAX_SITE_MB=200
MAX_SITE_FILES=2000

# SSH to the VPS scripts that issue each site's certificate (deploy/vps). Empty = disabled.
# PROVISION_SSH_TARGET=sitesprov@host.docker.internal
# PROVISION_SSH_KEY=/run/provisioner/key
# PROVISION_KNOWN_HOSTS=/run/provisioner/known_hosts
